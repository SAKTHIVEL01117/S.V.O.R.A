# S.V.O.R.A Backend Dockerfile
# Optimized for Python 3.12 with fast dependency installation via uv

FROM python:3.12-slim

# Prevent Python from writing .pyc files and buffer stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000 \
    HOST=0.0.0.0

WORKDIR /app

# Install uv for fast, reliable dependency installation
RUN pip install --no-cache-dir uv

# Copy dependencies file first to leverage Docker layer caching
COPY requirements.txt .

# Install dependencies directly into system environment
RUN uv pip install --system --no-cache -r requirements.txt

# Copy application source code and data assets
COPY . .

# Create non-root user for security
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose FastAPI backend port
EXPOSE 8000

# Health check to ensure API is responsive
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/testing/health')" || exit 1

# Start the uvicorn production server
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
