# S.V.O.R.A Backend Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# AWS Bedrock Settings
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_SESSION_TOKEN=your_optional_session_token
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# Operational Modes
# Set MOCK_BEDROCK=true to use the deterministic ATX-200 rule engine without AWS calls
MOCK_BEDROCK=false
# Set ALLOW_FALLBACK=true to gracefully fallback to ATX-200 rule engine if Bedrock API fails
ALLOW_FALLBACK=true
